# ─────────────────────────────────────────────────────────────
# 复制本文件为 .env，然后填入你自己的 key
#     cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# ⚠️ .env 已被 .gitignore 排除，**不要**把它提交上去。
# ─────────────────────────────────────────────────────────────

# ── 大模型与向量化：阿里云百炼（DashScope）OpenAI 兼容接口 ──
# 控制台：https://bailian.console.aliyun.com/  →  API-KEY 管理
# 注意 base_url 必须用**国内**端点；dashscope-intl.aliyuncs.com 会 401
LLM_API_KEY=sk-在这里填你的百炼key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max

EMBEDDING_API_KEY=sk-在这里填你的百炼key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# v4/v3 都是 1024 维。换 embedding 模型必须重建向量索引（向量空间会变）
EMBEDDING_MODEL=text-embedding-v4
# ⚠️ 百炼 embedding 单次 input 上限是 **10** 条（智谱是 64）。
#    这个值填大了会让每一批都失败、索引根本建不起来。
EMBEDDING_BATCH_SIZE=10

# ── 视觉模型（图表/公式/扭曲表格识别）──
# 不填 VLM_API_KEY 时会自动沿用 LLM_API_KEY（同一个百炼账号）
VLM_MODEL=qwen-vl-max
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_API_KEY=

# ── 以下各项项目当前未使用，保留以兼容旧配置 ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=business_db
